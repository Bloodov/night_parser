# Скопируйте этот файл в .env и заполните реальными значениями.
# .env НЕ должен попадать в git (см. .gitignore).

BOT_TOKEN=
BOT_USERNAME=
# Через запятую, если админов несколько: 111111,222222
ADMIN_IDS=

CRYPTOBOT_TOKEN=

# Необязательно. Путь к файлу БД. На Railway укажите путь ВНУТРИ
# примонтированного Volume (например /data/night_parser.db) — иначе база
# будет обнуляться при каждом перезапуске/редеплое. Локально можно не задавать.
DB_PATH=
